# Bi-directional dshot version CUAV-X7
#
# MantaShark extension: the upstream target only enabled input-capture DMA for
# TIM5 (PWM1-4).  All twelve EDF outputs are on three four-channel timer groups,
# so enable the representative CH1/CH3 capture requests for TIM4 (PWM5-8) and
# TIM1 (PWM9-12) as well.  The paired CH2/CH4 channels reuse CH1/CH3 capture DMA
# in the ChibiOS BDShot driver.

include ../CUAV-X7/hwdef.dat

undef PH10 PH12 PD12 PD14 PE9 PA10

PH10 TIM5_CH1 TIM5 PWM(1) GPIO(50) BIDIR
PH12 TIM5_CH3 TIM5 PWM(3) GPIO(52) BIDIR
PD12 TIM4_CH1 TIM4 PWM(5) GPIO(54) BIDIR
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(56) BIDIR
PE9  TIM1_CH1 TIM1 PWM(9) GPIO(58) BIDIR
PA10 TIM1_CH3 TIM1 PWM(11) GPIO(60) BIDIR
